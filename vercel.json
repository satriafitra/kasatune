{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/stream.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/deezer/(.*)",
      "destination": "https://api.deezer.com/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
